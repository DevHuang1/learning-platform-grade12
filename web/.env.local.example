# Copy to .env.local and fill in your Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Teacher invite code — teachers enter this when registering.
# Share it privately with your teaching staff. Change to any value you like.
NEXT_PUBLIC_TEACHER_INVITE_CODE=G12-TEACHER-DEMO

# Server-only answer processing secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
HUGGINGFACE_API_TOKEN=YOUR_HF_INFERENCE_PROVIDER_TOKEN
# Provider-compatible vision-language model used for teacher-review suggestions.
HUGGINGFACE_REVIEW_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# OpenAI-compatible Hugging Face Inference Providers endpoint.
HUGGINGFACE_INFERENCE_URL=https://router.huggingface.co/v1/chat/completions