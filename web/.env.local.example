# Copy to .env.local and fill in your Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Teacher invite code — teachers enter this when registering.
# Share it privately with your teaching staff. Change to any value you like.
NEXT_PUBLIC_TEACHER_INVITE_CODE=G12-TEACHER-DEMO